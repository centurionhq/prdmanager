{
  "name": "prdmanager",
  "version": "0.2.0",
  "description": "Product & Context Graph Engine (PRD-001/PRD-002): Feature Tree, Blueprints, Work Orders and drift detection on Neo4j, exposed via MCP",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit && tsc -p packages/web/tsconfig.test-client.json --noEmit",
    "prdm": "tsx --conditions=@prdm/source packages/cli/src/index.ts",
    "mcp": "tsx --conditions=@prdm/source packages/mcp/src/server.ts",
    "mcp:dist": "node packages/mcp/dist/server.js",
    "web:api": "tsx --conditions=@prdm/source packages/web/src/server.ts",
    "server": "tsx --conditions=@prdm/source packages/server/src/main.ts",
    "web": "node packages/web/dist/server/server.js",
    "test": "vitest run",
    "test:unit": "vitest run packages/core/tests/unit packages/cli/tests/unit packages/web/tests/unit packages/contracts/tests/unit packages/db/tests/unit packages/server/tests/unit",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/picomatch": "2.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
