{
  "name": "prdmanager",
  "version": "0.1.0",
  "description": "Product & Context Graph Engine (PRD-001): Feature Tree, Blueprints, Work Orders and drift detection on Neo4j, exposed via MCP",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "prdm": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prdm": "tsx src/cli/index.ts",
    "mcp": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "chokidar": "5.0.0",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "neo4j-driver": "6.2.0",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
