{
  "name": "@prdm/web",
  "version": "0.2.0",
  "description": "Read-only web explorer of the Feature Tree and drift (PRD-004)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.server.json && vite build",
    "dev": "vite",
    "typecheck": "tsc -b tsconfig.server.json --noEmit && tsc -b tsconfig.client.json --noEmit && tsc -p tsconfig.test-client.json --noEmit",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@prdm/core": "0.2.0",
    "cytoscape": "3.34.3",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "vite": "8.3.0"
  }
}
