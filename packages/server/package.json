{
  "name": "@prdm/server",
  "version": "0.2.0",
  "description": "Fastify SaaS server for the prdm platform: buildServer(deps) factory, health check and the shared error envelope (SDD-006)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@prdm/source": "./src/build-server.ts",
      "types": "./dist/build-server.d.ts",
      "import": "./dist/build-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bootstrap-superadmin": "tsx --conditions=@prdm/source src/cli/run-bootstrap-superadmin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prdm/collab": "0.2.0",
    "@prdm/contracts": "0.2.0",
    "@prdm/core": "0.2.0",
    "@prdm/db": "0.2.0",
    "@prdm/mcp": "0.2.0",
    "better-auth": "1.7.4",
    "fastify": "5.12.4",
    "nodemailer": "10.0.9",
    "openai": "7.15.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@prdm/testkit": "0.2.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "ws": "8.21.3"
  }
}
