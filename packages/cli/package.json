{
  "name": "@prdm/cli",
  "version": "0.2.0",
  "description": "prdm CLI: commands for the Product & Context Graph Engine",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "prdm": "dist/index.js"
  },
  "exports": {
    ".": {
      "@prdm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prdm/core": "0.2.0",
    "chokidar": "5.0.0",
    "commander": "14.0.3"
  }
}
