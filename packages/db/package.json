{
  "name": "@prdm/db",
  "version": "0.2.0",
  "description": "Drizzle schema, migrations and tenant-scoped Postgres access for the prdm SaaS platform (PRD-005)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@prdm/source": "./src/index.ts",
