{
  "mcpServers": {
    "neo4j": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/mcp-neo4j.sh"]
    },
    "neo4j-data-modeling": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-neo4j-data-modeling@0.8.2", "--transport", "stdio"]
    },
    "prdm-graph": {
      "type": "stdio",
      "command": "npx",
      "args": ["--no-install", "tsx", "src/mcp/server.ts"]
    }
  }
}
