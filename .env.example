# Generate with: openssl rand -hex 16
NEO4J_PASSWORD=change-me-min-8-chars
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_TEST_URI=neo4j://127.0.0.1:7688

# @prdm/web (PRD-004): defaults shown, only needed to override
PRDM_WEB_PORT=4600
# PRDM_WEB_HOST=127.0.0.1
# PRDM_WEB_ALLOW_REMOTE=1  # required if PRDM_WEB_HOST is not a loopback address

# @prdm/server (PRD-005 / SDD-006): default shown, only needed to override; always binds 127.0.0.1 in this slice
PRDM_SERVER_PORT=4601

# Postgres (PRD-005 / SDD-006): generate passwords with `openssl rand -hex 24`. POSTGRES_PASSWORD is
# prdm_owner's password (owns the schema, runs migrations); POSTGRES_APP_PASSWORD is prdm_app's (the
# role the server connects as: LOGIN, no superuser, no BYPASSRLS, not a member of prdm_owner).
# DATABASE_URL/DATABASE_TEST_URL (prdm_app) and DATABASE_MIGRATION_URL/DATABASE_TEST_MIGRATION_URL
# (prdm_owner) below must embed those same two passwords, not the literal placeholders shown here.
POSTGRES_PASSWORD=change-me-prdm-owner
POSTGRES_APP_PASSWORD=change-me-prdm-app
DATABASE_URL=postgres://prdm_app:change-me-prdm-app@127.0.0.1:5432/prdm
DATABASE_MIGRATION_URL=postgres://prdm_owner:change-me-prdm-owner@127.0.0.1:5432/prdm
DATABASE_TEST_URL=postgres://prdm_app:change-me-prdm-app@127.0.0.1:5433/prdm
DATABASE_TEST_MIGRATION_URL=postgres://prdm_owner:change-me-prdm-owner@127.0.0.1:5433/prdm
