# Generate with: openssl rand -hex 16
NEO4J_PASSWORD=change-me-min-8-chars
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_TEST_URI=neo4j://127.0.0.1:7688

# @prdm/web (PRD-004): defaults shown, only needed to override
PRDM_WEB_PORT=4600
# PRDM_WEB_HOST=127.0.0.1
# PRDM_WEB_ALLOW_REMOTE=1  # required if PRDM_WEB_HOST is not a loopback address

# @prdm/server (PRD-005 / SDD-006): default shown, only needed to override; always binds 127.0.0.1 in this slice
PRDM_SERVER_PORT=4601

# Postgres (PRD-005 / SDD-006): generate passwords with `openssl rand -hex 24`. POSTGRES_PASSWORD is
# prdm_owner's password (owns the schema, runs migrations); POSTGRES_APP_PASSWORD is prdm_app's (the
# role the server connects as: LOGIN, no superuser, no BYPASSRLS, not a member of prdm_owner).
# DATABASE_URL/DATABASE_TEST_URL (prdm_app) and DATABASE_MIGRATION_URL/DATABASE_TEST_MIGRATION_URL
# (prdm_owner) below must embed those same two passwords, not the literal placeholders shown here.
# Host ports for the local containers (defaults 5432/5433/1025/8025). Override them when they are already
# taken on your machine, and keep the ports in the DATABASE_* URLs below in sync.
PRDM_POSTGRES_PORT=5432
PRDM_POSTGRES_TEST_PORT=5433
PRDM_MAILPIT_SMTP_PORT=1025
PRDM_MAILPIT_UI_PORT=8025
POSTGRES_PASSWORD=change-me-prdm-owner
POSTGRES_APP_PASSWORD=change-me-prdm-app
DATABASE_URL=postgres://prdm_app:change-me-prdm-app@127.0.0.1:5432/prdm
# WO-246: shared by HTTP request handling and every live collab document's persistence; default 20.
PRDM_DATABASE_MAX_CONNECTIONS=20
DATABASE_MIGRATION_URL=postgres://prdm_owner:change-me-prdm-owner@127.0.0.1:5432/prdm
DATABASE_TEST_URL=postgres://prdm_app:change-me-prdm-app@127.0.0.1:5433/prdm
DATABASE_TEST_MIGRATION_URL=postgres://prdm_owner:change-me-prdm-owner@127.0.0.1:5433/prdm

# @prdm/server auth/session (PRD-005 / SDD-006). PRDM_PUBLIC_URL is the exact public origin
# (used as better-auth's baseURL and the only Host this server accepts on /api/auth/*).
# Generate BETTER_AUTH_SECRET with: openssl rand -hex 32 (>= 32 bytes required).
PRDM_PUBLIC_URL=http://127.0.0.1:4601
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-secret
# Comma-separated absolute origins, no wildcards.
PRDM_TRUSTED_ORIGINS=http://127.0.0.1:4601
# Set to 1 only when this server sits behind a reverse proxy that sets X-Forwarded-* headers.
PRDM_TRUST_PROXY=0

# SMTP (PRD-005 / SDD-006): mailpit in dev (no auth needed), real SMTP in production.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="prdm <no-reply@example.test>"

# /collab realtime documents (PRD-005 / SDD-008): defaults shown, only needed to override. `ws`'s own
# maxPayload for the /collab WebSocket upgrade - an oversized frame closes the raw socket (code 1009)
# before any Hocuspocus/Yjs framing runs.
PRDM_COLLAB_MAX_PAYLOAD_BYTES=1048576
# Numeric limits (WO-152): exceeding any of these closes the offending connection and audits it.
PRDM_COLLAB_MAX_RENDERED_BYTES=524288
PRDM_COLLAB_MAX_ENCODED_STATE_BYTES=20971520
PRDM_COLLAB_MAX_CONNECTIONS_PER_USER=20
PRDM_COLLAB_MAX_CONNECTIONS_PER_DOCUMENT=50
PRDM_COLLAB_MAX_UPDATES_PER_SEC_PER_USER=30
PRDM_COLLAB_MAX_UPDATES_PER_SEC_PER_DOCUMENT=100

# DeepSeek (ADR-006/SDD-009): optional — the conversational agent is disabled server-wide unless
# DEEPSEEK_API_KEY is set. Real key/URL live only in .env or environment secrets, never committed.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# SDD-009 Seguridad y costo: agent quotas/rate limit (names only; defaults match the SDD).
# PRDM_AGENT_DAILY_TOKENS_PER_ORG=200000
# PRDM_AGENT_DAILY_TOKENS_GLOBAL=2000000
# PRDM_AGENT_RPM_PER_USER=10
